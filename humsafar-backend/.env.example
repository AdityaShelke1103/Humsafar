# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.

# --- Neo4j (Person 1) ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Search provider (Person 2) ---
TAVILY_API_KEY=

# --- LLM providers (Person 3) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER_PRIMARY=groq
LLM_PROVIDER_FALLBACK=gemini_flash

# --- Procedure freshness policy (Person 1 / Person 4) ---
FRESHNESS_DAYS=30

# --- Demo mode (Person 4) ---
DEMO_MODE=false

# --- App URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
